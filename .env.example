# Provider: lmstudio | nim | claude
LLM_PROVIDER=lmstudio

# LM Studio (local dev)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=microsoft/phi-4-reasoning-plus

# NVIDIA NIM (Streamlit deployment) - https://build.nvidia.com
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.2-90b-vision-instruct

# Claude (provided on request)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
